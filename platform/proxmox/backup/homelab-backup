#!/bin/bash
# homelab-backup: off-site backup of everything irreplaceable, from ZFS snapshots, with restic.
# Runs on the Proxmox host (only the host can snapshot and sees every dataset). Installed as
# /usr/local/sbin/homelab-backup, started by homelab-backup.timer. Config: /etc/homelab-backup/env.
#
#   homelab-backup             snapshot -> restic backup -> forget/prune (prune only on PRUNE_WEEKDAY)
#   homelab-backup --dry-run   create and mount the snapshots, list what would be backed up, upload nothing
#   homelab-backup check       restic check, reads READ_SUBSET of the stored data (weekly timer)
#
# The target is only RESTIC_REPOSITORY in the env file (today sftp: to an off-site storage box);
# moving to other storage: restic copy (docs/data-protection.md). Not backed up: mainpool/media (replaceable), guest system disks.
set -euo pipefail

ENV=/etc/homelab-backup/env
[ -r "$ENV" ] || { echo "missing $ENV" >&2; exit 1; }
set -a; . "$ENV"; set +a
: "${RESTIC_REPOSITORY:?}" "${RESTIC_PASSWORD_FILE:?}"

POOL=${POOL:-mainpool}
DATASETS=${DATASETS:-"documents immich-library nextcloud-data websites backups/openbao"}
ZVOL=${ZVOL:-mainpool/vm/vm-100-disk-0}          # Docker VM data disk: /srv/appdata + Docker volumes
KEEP=${KEEP:-"--keep-daily 7 --keep-weekly 4 --keep-monthly 6"}
PRUNE_WEEKDAY=${PRUNE_WEEKDAY:-7}                 # 1 = Monday ... 7 = Sunday
READ_SUBSET=${READ_SUBSET:-5%}
SNAP=restic                                       # our own snapshot name, recreated every run
CLONE=${ZVOL%/*}/restic-appdata
MNT=/mnt/homelab-backup
LOCK=/run/homelab-backup.lock
log() { printf '[%s] %s
' "$(date +%T)" "$*"; }
# progress lines from restic: live on a terminal, once a minute in the journal (systemd has no terminal)
[ -t 1 ] || export RESTIC_PROGRESS_FPS=${RESTIC_PROGRESS_FPS:-0.0167}

exec 9>"$LOCK"; flock -n 9 || { echo "another homelab-backup is running" >&2; exit 1; }

if [ "${1:-}" = check ]; then
  restic check --read-data-subset="$READ_SUBSET"
  exit 0
fi
DRY=0; [ "${1:-}" = --dry-run ] && DRY=1

cleanup() (   # subshell: its "set +e" must not leak into the rest of the script
  set +e
  mountpoint -q "$MNT/appdata" && umount "$MNT/appdata"
  zfs list -H "$CLONE" >/dev/null 2>&1 && zfs destroy -r "$CLONE"   # -r: sanoid may have snapshotted the clone
  zfs list -H "$ZVOL@$SNAP" >/dev/null 2>&1 && zfs destroy "$ZVOL@$SNAP"
  for d in $DATASETS; do zfs list -H "$POOL/$d@$SNAP" >/dev/null 2>&1 && zfs destroy "$POOL/$d@$SNAP"; done
  true
)
trap cleanup EXIT
cleanup        # leftovers of an aborted run

log "creating snapshots"
# 1. one consistent point in time: snapshot every dataset and the zvol together
zfs snapshot $(for d in $DATASETS; do printf '%s ' "$POOL/$d@$SNAP"; done) "$ZVOL@$SNAP"

# 2. the zvol holds an ext4 file system: clone the snapshot, mount it read-only without replaying the journal
zfs clone -o readonly=on "$ZVOL@$SNAP" "$CLONE"
dev=/dev/zvol/$CLONE
for _ in $(seq 1 30); do [ -b "$dev" ] && break; sleep 1; done
[ -b "$dev" ] || { echo "zvol device $dev did not appear" >&2; exit 1; }
mkdir -p "$MNT/appdata"
mount -o ro,noload "$dev" "$MNT/appdata"
log "app data mounted read-only from the snapshot clone"

# 3. paths: dataset snapshots through .zfs/snapshot, app data from the clone
PATHS=()
for d in $DATASETS; do
  mp=$(zfs get -H -o value mountpoint "$POOL/$d")
  PATHS+=("$mp/.zfs/snapshot/$SNAP")
done
PATHS+=("$MNT/appdata/AppData" "$MNT/appdata/docker/volumes")
for p in "${PATHS[@]}"; do
  [ -d "$p" ] || { echo "path to back up is missing: $p" >&2; exit 1; }
done

IMMICH=$(zfs get -H -o value mountpoint "$POOL/immich-library")/.zfs/snapshot/$SNAP
EXCLUDES=(
  --exclude "$MNT/appdata/AppData/immich/model-cache"   # ML models, downloaded again
  --exclude "$IMMICH/thumbs"                            # regenerated by Immich
  --exclude "$IMMICH/encoded-video"                     # regenerated by Immich
  --exclude-caches
)

if [ "$DRY" = 1 ]; then
  log "dry run: restic reads every file once to see what it would upload (first time: all of it, 10-30 min)"
  restic backup --dry-run --host homelab --tag nightly "${EXCLUDES[@]}" "${PATHS[@]}"
  log "dry run done, cleaning up"
  exit 0
fi

# 4. upload (only changed chunks), then thin out old snapshots
log "uploading changes"
restic backup --host homelab --tag nightly --no-scan "${EXCLUDES[@]}" "${PATHS[@]}"
log "upload done, applying retention"
if [ "$(date +%u)" = "$PRUNE_WEEKDAY" ]; then
  restic forget --host homelab --tag nightly $KEEP --prune
else
  restic forget --host homelab --tag nightly $KEEP
fi
log "backup finished"
