# /etc/homelab-backup/env (root 600). Copy, fill in, never commit the real one.
# Target: a storage box over SFTP; "storagebox" is a Host alias in /root/.ssh/config (key, port, pinned host key).
# Moving to another target only changes this line (docs/data-protection.md).
RESTIC_REPOSITORY=sftp:storagebox:homelab
# restic encryption password, one line, root 600. ALSO in the password manager: without it the backup is unreadable.
RESTIC_PASSWORD_FILE=/etc/homelab-backup/restic-password
# local cache, speeds up every run after the first
RESTIC_CACHE_DIR=/var/cache/restic
# read files gently from the pool while the lab runs
RESTIC_READ_CONCURRENCY=2
# fewer, larger packs (MiB): fewer files on the box; the first run used 64
RESTIC_PACK_SIZE=64
# optional overrides (defaults in the script):
# DATASETS="documents immich-library nextcloud-data websites backups/openbao"
# KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 6"
# PRUNE_WEEKDAY=7
# READ_SUBSET=5%
