# /etc/pangolin-backup/env (root 600). Copy, fill in, never commit the real one.
# Target: own Storage Box sub-account (base directory /pangolin/), "storagebox" is the Host alias in /root/.ssh/config.
RESTIC_REPOSITORY=sftp:storagebox:restic
# restic encryption password, one line, root 600. ALSO in the password manager ("pangolin restic").
RESTIC_PASSWORD_FILE=/etc/pangolin-backup/restic-password
RESTIC_CACHE_DIR=/var/cache/restic
# host config outside /opt/pangolin that belongs to the edge (only paths that exist; a missing one stops the run)
EXTRA_PATHS="/etc/crowdsec /etc/fail2ban /usr/local/bin"
# optional overrides (defaults in the script):
# KEEP="--keep-hourly 24 --keep-daily 7 --keep-weekly 4 --keep-monthly 6"
# PRUNE_WEEKDAY=7
# PRUNE_HOUR=04
# READ_SUBSET=100%
