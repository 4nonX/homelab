# D-PlaneOS Website Configuration
# 
# Edit the values in this file, then redeploy the stack

# ============================================
# PORT CONFIGURATION
# ============================================

# Port to expose the website on
# Default: 8080
# Change if port is already in use
WEBSITE_PORT=


# ============================================
# GITHUB & DOMAIN CONFIGURATION
# ============================================

# Your GitHub username (REQUIRED)
# This will be used in links throughout the website
GITHUB_USERNAME=

# Your website domain (optional)
# Leave as-is if accessing via IP:port
# Set to your domain if using reverse proxy
WEBSITE_DOMAIN=


# ============================================
# REVERSE PROXY (Optional)
# ============================================

# If using reverse proxy, you may not need to expose the port
# Set WEBSITE_PORT to an internal port like 8080
# Configure your reverse proxy to forward to: dplaneos-website:80


# ============================================
# NOTES
# ============================================

# - Don't expose to internet without HTTPS
# - Use Nginx Proxy Manager, Traefik, or Cloudflare Tunnel
# - Update GitHub username in website files after first run
D_PLANEOS_WEBSITE_PORT=
