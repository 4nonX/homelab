# =============================================================================
# Homelab - Environment Variables Template
#
# Copy to .env and fill in values. Never commit .env to version control.
# The .gitignore already excludes .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
TIMEZONE=Europe/Berlin

# Shared mail settings (used by dan-portfolio, forgejo, librum)
MAIL_DOMAIN=yourdomain.com
SMTP_USERNAME=you@yourdomain.com

# -----------------------------------------------------------------------------
# Network / Reverse Proxy
# -----------------------------------------------------------------------------

# IP of the Traefik/Pangolin inner proxy (Raspberry Pi 5 on local LAN)
PROXY_IP=

# Local IP of the NAS server running Nextcloud
NEXTCLOUD_LOCAL_IP=

# Public domain for Nextcloud (e.g. cloud.yourdomain.com)
NEXTCLOUD_DOMAIN=

# Same domain with escaped dots for Collabora config (e.g. cloud\\.yourdomain\\.com)
NEXTCLOUD_DOMAIN_ESCAPED=

# -----------------------------------------------------------------------------
# Port overrides (defaults shown - only set if you need non-default ports)
# -----------------------------------------------------------------------------
NEXTCLOUD_PORT=10081
COLLABORA_PORT=9980
SIGNALING_PORT=8188

# Path to Talk signaling server config on the host
SIGNALING_CONFIG_PATH=/DATA/AppData/talk-signaling/server.conf

# -----------------------------------------------------------------------------
# Nextcloud stack (services/productivity/nextcloud.yml)
# -----------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=          # Change this before first run

DB_PASSWORD=             # PostgreSQL password for Nextcloud database
COLLABORA_PASSWORD=      # Collabora Online admin password

# -----------------------------------------------------------------------------
# Pi-hole (infrastructure/networking/pihole/pihole.yml)
# -----------------------------------------------------------------------------
PIHOLE_WEBPASSWORD=

# -----------------------------------------------------------------------------
# Dockpeek (infrastructure/monitoring/big-bear-dockpeek/dockpeek.yml)
# -----------------------------------------------------------------------------
DOCKPEEK_USERNAME=           # Login username
DOCKPEEK_PASSWORD=           # Login password
DOCKPEEK_SECRET_KEY=         # Session secret (set to same value as PASSWORD or longer random string)

# -----------------------------------------------------------------------------
# Media stack - Gluetun VPN gateway (services/media/arr-suite.yml)
# -----------------------------------------------------------------------------
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=   # ProtonVPN WireGuard private key

# -----------------------------------------------------------------------------
# Books stack (services/media/books/books.yml)
# -----------------------------------------------------------------------------
GRIMMORY_DB_PASSWORD=    # MariaDB password for Grimmory ebook library
BOOKKEEP_DB_PASSWORD=    # PostgreSQL password for Bookkeep
HARDCOVER_API_TOKEN=     # Hardcover JWT API token
BOOKKEEP_SECRET_KEY=     # Bookkeep secret key (base64)
READMEABOOK_PUBLIC_URL=http://localhost:3030

# -----------------------------------------------------------------------------
# Monitoring - Beszel (infrastructure/monitoring/)
# -----------------------------------------------------------------------------
BESZEL_AGENT_SSH_KEY=    # SSH public key registered in Beszel hub
BESZEL_AGENT_TOKEN=      # Agent token from Beszel hub
BESZEL_HUB_URL=          # e.g. http://192.168.x.x:8099

# -----------------------------------------------------------------------------
# Networking - Newt tunnel (infrastructure/networking/newt/newt.yml)
# -----------------------------------------------------------------------------
PANGOLIN_ENDPOINT=       # e.g. https://pangolin.yourdomain.com
NEWT_ID=                 # Newt client ID from Pangolin dashboard
NEWT_SECRET=             # Newt client secret from Pangolin dashboard

# -----------------------------------------------------------------------------
# Tailscale DERP relay (infrastructure/networking/tailscale-derper/)
# -----------------------------------------------------------------------------
DERP_DOMAIN=             # Domain for the DERP server (must match cert filenames)

# -----------------------------------------------------------------------------
# MinIO object storage (infrastructure/storage/minio/minio.yml)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=         # MinIO admin username
MINIO_ROOT_PASSWORD=     # MinIO admin password

# -----------------------------------------------------------------------------
# Development stack - DPlaneOS website (services/development/d-planeos-website.yml)
# -----------------------------------------------------------------------------
WEBSITE_PORT=8080
GITHUB_USERNAME=
WEBSITE_DOMAIN=

# -----------------------------------------------------------------------------
# Development stack - Dan portfolio (services/development/dan-portfolio/)
# -----------------------------------------------------------------------------
DAN_PORTFOLIO_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Development stack - Forgejo (services/development/forgejo/forgejo.yml)
# -----------------------------------------------------------------------------
FORGEJO_DB_PASSWORD=
FORGEJO_SMTP_PASSWORD=
FORGEJO_ROOT_URL=        # e.g. https://forge.yourdomain.com/
FORGEJO_DOMAIN=          # e.g. forge.yourdomain.com

# -----------------------------------------------------------------------------
# Development stack - Resume Builder (services/development/resume-builder.yml)
# -----------------------------------------------------------------------------
RESUME_BUILDER_DB_PASSWORD=     # PostgreSQL password for the resume-builder database
RESUME_BUILDER_JWT_SECRET=      # Min 32 chars, cryptographically random
RESUME_BUILDER_FRONTEND_URL=    # e.g. https://resume.yourdomain.com (defaults to http://localhost:3000)
RESUME_BUILDER_API_URL=         # e.g. https://resume-api.yourdomain.com (defaults to http://localhost:8000)
GEMINI_API_KEY=                 # Google Gemini API key (used by ai_parser.py for resume parsing)

# -----------------------------------------------------------------------------
# Productivity - Cryptpad (services/productivity/cryptpad/cryptpad.yml)
# -----------------------------------------------------------------------------
CRYPTPAD_MAIN_DOMAIN=    # e.g. https://cryptpad.yourdomain.com
CRYPTPAD_SANDBOX_DOMAIN= # e.g. https://cryptpad-sandbox.yourdomain.com

# -----------------------------------------------------------------------------
# Productivity - Glass Keep notes (services/productivity/glass-keep/)
# -----------------------------------------------------------------------------
GLASS_KEEP_JWT_SECRET=   # Long random string
GLASS_KEEP_ADMIN_EMAIL=  # Admin account username/email

# -----------------------------------------------------------------------------
# Productivity - Librum (services/productivity/librum/librum.yml)
# -----------------------------------------------------------------------------
LIBRUM_JWT_KEY=          # JWT signing key
LIBRUM_SMTP_PASSWORD=
LIBRUM_DB_PASSWORD=
LIBRUM_DB_ROOT_PASSWORD=
LIBRUM_ADMIN_EMAIL=
LIBRUM_ADMIN_PASSWORD=
LIBRUM_OPENAI_TOKEN=     # Optional: OpenAI API key for AI features

# -----------------------------------------------------------------------------
# Productivity - Revolt.chat (services/productivity/revolt/revolt.yml)
# -----------------------------------------------------------------------------
REVOLT_RABBIT_USER=      # RabbitMQ username for internal message broker
REVOLT_RABBIT_PASS=      # RabbitMQ password for internal message broker
REVOLT_MINIO_USER=       # MinIO username for Revolt file storage
REVOLT_MINIO_PASS=       # MinIO password for Revolt file storage

# -----------------------------------------------------------------------------
# Management - Heaper (services/management/heaper/heaper.yml)
# -----------------------------------------------------------------------------
HEAPER_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Management - Arcane (services/management/arcane/arcane.yml)
# -----------------------------------------------------------------------------
ARCANE_APP_URL=          # e.g. http://192.168.x.x:3552
ARCANE_ENCRYPTION_KEY=   # Long random base64 string
ARCANE_JWT_SECRET=       # Long random base64 string

# -----------------------------------------------------------------------------
# Management - Stacks/Zelest (services/management/stacks.yml)
# -----------------------------------------------------------------------------
ZELEST_USERNAME=         # Initial admin username (only used on first run)
ZELEST_PASSWORD=         # Initial admin password (only used on first run)

# -----------------------------------------------------------------------------
# Productivity - Paperless-NGX (services/productivity/big-bear-paperless-ngx/paperless.yml)
# -----------------------------------------------------------------------------
PAPERLESS_ADMIN_USER=            # Admin login username
PAPERLESS_ADMIN_PASSWORD=        # Admin login password
PAPERLESS_DB_USER=               # PostgreSQL username for paperless database
PAPERLESS_DB_PASSWORD=           # PostgreSQL password for paperless database
PAPERLESS_URL=                   # Public URL, e.g. https://paperless.yourdomain.com
PAPERLESS_ALLOWED_HOSTS=         # Comma-separated: paperless.yourdomain.com,localhost
PAPERLESS_CSRF_TRUSTED_ORIGINS=  # Comma-separated: https://paperless.yourdomain.com

# -----------------------------------------------------------------------------
# Shared database credentials
# Used by multiple stacks - consider unique passwords per service in production
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=       # Generic fallback; prefer per-service DB_PASSWORD above
